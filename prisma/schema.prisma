generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VocabularyWord {
  id            String   @id @default(cuid())
  word          String   @unique
  partOfSpeech  String?
  pronunciation String?
  difficulty    Int      @default(3)
  sourceContext String?
  sourceUrl     String?
  sourceTitle   String?
  dateAdded     DateTime @default(now())
  isArchived    Boolean  @default(false)

  // full AI response: meanings, exercises, synonyms, antonyms...
  aiData      Json?
  aiModel     String?
  aiUpdatedAt DateTime?

  learningState LearningState?
  reviews       ReviewHistory[]

  @@index([dateAdded])
  @@index([isArchived])
}

model LearningState {
  id             String     @id @default(cuid())
  wordId         String     @unique
  status         WordStatus @default(NEW)
  knowledgeScore Float      @default(0)
  easeFactor     Float      @default(2.5)
  intervalDays   Int        @default(0)
  repetitions    Int        @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@index([status])
}

model ReviewHistory {
  id             String       @id @default(cuid())
  submissionId   String?      @unique
  wordId         String
  exerciseType   ExerciseType
  result         ReviewResult
  responseTimeMs Int?
  userAnswer     String?
  correctAnswer  String?
  hintUsed       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, createdAt])
}

enum WordStatus {
  NEW
  LEARNING
  FAMILIAR
  STRONG
  MASTERED
}

enum ExerciseType {
  DEFINITION_RECALL
  MULTIPLE_CHOICE
  CONTEXT_COMPLETION
  MEANING_FROM_CONTEXT
  WORD_SELECTION
  SENTENCE_CREATION
  SIMILAR_WORD_DISTINCTION
}

enum ReviewResult {
  CORRECT
  INCORRECT
  PARTIAL
  SKIPPED
}
